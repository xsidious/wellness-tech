DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&schema=wtdist"
SESSION_SECRET="replace-with-a-long-random-string"
FIELD_KEY="replace-with-a-different-long-random-string"
# Live: "false" (codes only arrive by email). Local demo: "true" (also shows code on screen).
SANDBOX_AUTH="false"
# Payments: "sandbox" (last-4 tokenize) or "live" (gateway nonce required). Defaults to sandbox unless set.
PAYMENTS_MODE="sandbox"
PAYMENTS_SANDBOX="true"
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Wellness Tech <noreply@thewellnesstech.com>"

# Cloudflare Turnstile (bot / fraud protection on login + signup)
# Create keys at https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
RXCORE_WEBHOOK_SECRET="replace-with-the-rxcore-sandbox-secret"
RXCORE_BASE_URL="http://localhost:3010/api/rxcore"

# RxHere Partner API (staging: https://rxhere.qrolic.com/api)
RXHERE_API_BASE_URL="https://rxhere.qrolic.com/api"
RXHERE_API_TOKEN="replace-with-partner-api-token"
RXHERE_WEBHOOK_SECRET="replace-with-webhook-secret-from-partner-portal"
RXHERE_WEBHOOK_URL="https://www.thewellnesstech.com/api/webhooks/rxhere"

# KIAN Privé partner order handoff
WT_PARTNER_ORDER_SECRET="shared-secret-with-kian"
KIAN_STATUS_WEBHOOK_URL="https://www.kianprive.com/api/webhooks/wellness-tech-order"
KIAN_PARTNER_SECRET="same-as-WT_PARTNER_ORDER_SECRET-or-kian-specific"

# Portal user that owns API-placed orders (Alen). Sent as X-User-Id.
EVENTIDE_PLACED_BY_USER_ID="daf4ab88-1c9d-4c8f-a4fe-20e3b5dcc318"
