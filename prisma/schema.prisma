generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String   @id @default(cuid())
  type                 String
  legalName            String
  pricingTier          String   @default("standard")
  verificationTier     Int      @default(0)
  status               String   @default("active")
  referringAffiliateId String   @default("")
  assignedRep          String   @default("Alex Morgan")
  slug                 String   @unique
  onboardingComplete   Boolean  @default(false)
  createdAt            DateTime @default(now())
  users                User[]
  orders               Order[]
  patients             PatientRef[]
  clinicalPatients     ClinicalPatient[]
  apiKeys              ApiKey[]
  messages             Message[]
  locations            PracticeLocation[]
  settlements          Settlement[]
}

model PracticeLocation {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  label     String       @default("Main")
  street1   String       @default("")
  street2   String       @default("")
  city      String       @default("")
  state     String       @default("")
  zip       String       @default("")
  phone     String       @default("")
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model User {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  email      String    @unique
  name       String
  phone      String    @default("")
  roles        String
  passwordHash String    @default("")
  mfaHash      String    @default("")
  mfaEnabled   Boolean   @default(false)
  pharmacyId String?
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  clinicalPatientId String?
  clinicalPatient   ClinicalPatient? @relation("PatientUser", fields: [clinicalPatientId], references: [id], onDelete: SetNull)
  lastLoginAt DateTime?
  createdAt  DateTime  @default(now())
  credential PrescriberCredential?
  cartItems  CartItem[]
  orders     Order[] @relation("PlacedBy")
  affiliate  AffiliateProfile?
  escriptsSigned EScript[] @relation("EScriptSigner")
}

model MagicCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PrescriberCredential {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  npi              String
  displayName      String
  specialty        String   @default("")
  licenseCipher    String   @default("")
  deaCipher        String   @default("")
  oigStatus        String   @default("pending_vendor")
  verificationTier Int      @default(0)
  checkedAt        DateTime @default(now())
}

model Product {
  id                String   @id @default(cuid())
  sku               String   @unique
  rxcoreFormularyId String
  name              String
  productClass      String
  category          String
  form              String   @default("")
  strength          String   @default("")
  size              String   @default("")
  budDays           Int      @default(0)
  storage           String   @default("ambient")
  rxRequired        Boolean  @default(false)
  officeUse         Boolean  @default(false)
  priceCents        Int
  active            Boolean  @default(true)
  orderable         Boolean  @default(true)
  holdReason        String   @default("")
  description       String   @default("")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model PatientRef {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  rxcorePatientId String       @unique
  initials        String
}

/// Full clinical chart mirrored from KIAN (intake, therapy, signatures, demographics).
model ClinicalPatient {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id])
  email              String
  fullName           String
  phone              String       @default("")
  dateOfBirth        String       @default("")
  gender             String       @default("")
  allergies          String       @default("")
  medications        String       @default("")
  addressJson        String       @default("{}")
  kianIntakeId       String       @default("")
  kianReference      String       @default("")
  sourceSite         String       @default("kian-prive")
  intakeStatus       String       @default("")
  statusNote         String       @default("")
  programsJson       String       @default("[]")
  intakePayloadJson  String       @default("{}")
  signaturesJson     String       @default("[]")
  therapyJson        String       @default("{}")
  clinicalChartJson  String       @default("{}")
  lastOrderId        String       @default("")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  orders             Order[]
  portalUsers        User[]       @relation("PatientUser")
  escripts           EScript[]
  refillRequests     RefillRequest[]
  messages           Message[]

  @@unique([orgId, email, kianIntakeId])
  @@index([email])
  @@index([kianIntakeId])
  @@index([fullName])
}

model CartItem {
  id              String @id @default(cuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id])
  productId       String
  qty             Int
  patientInitials String @default("")
  rxcorePatientId String @default("")
  clinicalPatientId String @default("")
  sig             String @default("")
  daysSupply      Int    @default(30)
  shipDestination String @default("PRACTICE")
}

model Order {
  id                 String   @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id])
  placedById         String
  placedBy           User     @relation("PlacedBy", fields: [placedById], references: [id])
  clinicalPatientId  String?
  clinicalPatient    ClinicalPatient? @relation(fields: [clinicalPatientId], references: [id], onDelete: SetNull)
  pharmacyId         String?
  pharmacy           Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  invoiceNumber      String   @unique
  status             String
  paymentStatus      String
  paymentToken       String   @default("")
  cardLast4          String   @default("")
  shippingFeeCents   Int
  subtotalCents      Int
  totalCents         Int
  rxcoreOrderId      String   @default("")
  rxhereOrderId      String   @default("")
  rxhereBatchId      String   @default("")
  partnerExternalRef String   @default("")
  shippingMethod     String   @default("2_DAY")
  shipDestination    String   @default("PRACTICE")
  trackingNumber     String   @default("")
  escriptStatus      String   @default("not_required")
  patientCipher      String   @default("")
  patientJson        String   @default("")
  prescriberJson     String   @default("")
  shipToJson         String   @default("")
  notes              String   @default("")
  source             String   @default("portal")
  splitMessage       String   @default("")
  kianIntakeId       String   @default("")
  clinicalChartJson  String   @default("{}")
  intakePayloadJson  String   @default("{}")
  signaturesJson     String   @default("[]")
  therapyJson        String   @default("{}")
  createdAt          DateTime @default(now())
  lines              OrderLine[]
  events             OrderEvent[]
  commissions        Commission[]
  escripts           EScript[]
  settlementLines    SettlementLine[]

  @@index([partnerExternalRef])
  @@index([rxhereOrderId])
  @@index([kianIntakeId])
  @@index([clinicalPatientId])
  @@index([pharmacyId])
  @@index([escriptStatus])
}

model OrderLine {
  id               String @id @default(cuid())
  orderId          String
  order            Order  @relation(fields: [orderId], references: [id])
  sku              String
  name             String
  productClass     String
  qty              Int
  unitPriceCents   Int
  patientInitials  String @default("")
  rxcorePatientId  String @default("")
  prescriber       String @default("")
  sig              String @default("")
  strength         String @default("")
  size             String @default("")
  dosageForm       String @default("")
  daysSupply       Int    @default(0)
  lineStatus       String @default("received")
  routedSource     String @default("")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  eventId   String   @unique
  type      String
  payload   String
  createdAt DateTime @default(now())
}

model Refill {
  id              String   @id @default(cuid())
  orgId           String
  patientInitials String
  productName     String
  productSku      String
  dueAt           DateTime
  status          String   @default("due")
  autopay         Boolean  @default(true)
  daysSupply      Int      @default(30)
}

model AffiliateProfile {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id])
  code           String @unique
  w9Status       String @default("sandbox_received")
  payoutToken    String @default("")
  commissionPlan String @default("devices-and-supplies-10")
  parentId       String?
  parent         AffiliateProfile?  @relation("AffiliateDownline", fields: [parentId], references: [id], onDelete: SetNull)
  children       AffiliateProfile[] @relation("AffiliateDownline")
  partnerLink    String @default("")
}

model Commission {
  id              String   @id @default(cuid())
  affiliateUserId String
  orgId           String
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  eligibleCents   Int
  rateBps         Int
  amountCents     Int
  status          String   @default("pending_batch")
  createdAt       DateTime @default(now())
}

model ContentItem {
  id         String @id @default(cuid())
  type       String
  title      String
  body       String
  accessTier Int    @default(1)
  version    Int    @default(1)
  slug       String @unique
  protocolSku String @default("")
}

model ApiKey {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  label     String
  keyHash   String       @unique
  prefix    String
  sandbox   Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model WebhookDelivery {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  payload   String
  status    String
  createdAt DateTime @default(now())
}

model Message {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  authorName        String
  authorUserId      String       @default("")
  body              String
  /// rep = practice↔Wellness Tech; patient = practice↔patient portal
  channel           String       @default("rep")
  clinicalPatientId String?
  clinicalPatient   ClinicalPatient? @relation(fields: [clinicalPatientId], references: [id], onDelete: SetNull)
  readAt            DateTime?
  createdAt         DateTime     @default(now())

  @@index([orgId, channel])
  @@index([clinicalPatientId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String   @default("")
  action    String
  object    String
  before    String   @default("")
  after     String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  response  String
  createdAt DateTime @default(now())
}

model Pharmacy {
  id                 String   @id @default(cuid())
  name               String
  legalName          String   @default("")
  type               String   @default("Hybrid")
  region             String   @default("")
  status             String   @default("online")
  specialtiesJson    String   @default("[]")
  capabilitiesJson   String   @default("[]")
  erpJson            String   @default("[]")
  statesServedJson   String   @default("[]")
  shippingModesJson  String   @default("[]")
  sla                String   @default("")
  description        String   @default("")
  contactName        String   @default("")
  contactEmail       String   @default("")
  phone              String   @default("")
  website            String   @default("")
  licenseNumber      String   @default("")
  licenseState       String   @default("")
  npi                String   @default("")
  deaNumber          String   @default("")
  ncpdpId            String   @default("")
  street1            String   @default("")
  city               String   @default("")
  state              String   @default("")
  zip                String   @default("")
  hours              String   @default("")
  coldChain          Boolean  @default(false)
  patientShip        Boolean  @default(true)
  practiceShip       Boolean  @default(true)
  internalNotes      String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
  users              User[]
  locations          PharmacyLocation[]
}

model PharmacyLocation {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  label      String   @default("Main")
  street1    String   @default("")
  city       String   @default("")
  state      String   @default("")
  zip        String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model EScript {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  clinicalPatientId   String?
  clinicalPatient     ClinicalPatient? @relation(fields: [clinicalPatientId], references: [id], onDelete: SetNull)
  signedById          String?
  signedBy            User?    @relation("EScriptSigner", fields: [signedById], references: [id], onDelete: SetNull)
  status              String   @default("draft")
  npi                 String   @default("")
  displayName         String   @default("")
  signerEmail         String   @default("")
  licenseState        String   @default("")
  licenseNumber       String   @default("")
  deaNumber           String   @default("")
  signatureDataUrl    String   @default("")
  directions          String   @default("")
  attestationText     String   @default("")
  attestationVersion  String   @default("")
  signedIp            String   @default("")
  signedUserAgent     String   @default("")
  patientSnapshotJson String   @default("{}")
  linesSnapshotJson   String   @default("[]")
  contentHash         String   @default("")
  version             Int      @default(1)
  signedAt            DateTime?
  createdAt           DateTime @default(now())

  @@index([orderId])
  @@index([status])
  @@index([contentHash])
}

model Settlement {
  id          String   @id @default(cuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  periodStart DateTime
  periodEnd   DateTime
  kind        String   @default("practice")
  status      String   @default("open")
  totalCents  Int      @default(0)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  closedAt    DateTime?
  lines       SettlementLine[]

  @@index([status])
  @@index([orgId])
}

model SettlementLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  label        String
  amountCents  Int
  createdAt    DateTime   @default(now())
}

model RefillRequest {
  id                String   @id @default(cuid())
  clinicalPatientId String
  clinicalPatient   ClinicalPatient @relation(fields: [clinicalPatientId], references: [id])
  productSku        String   @default("")
  productName       String
  note              String   @default("")
  status            String   @default("requested")
  createdAt         DateTime @default(now())
}
